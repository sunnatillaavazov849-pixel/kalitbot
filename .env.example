# Bu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring.
# .env faylini HECH QACHON GitHub'ga yuklamang (u .gitignore da).

# @BotFather -> /newbot
BOT_TOKEN=
# @userinfobot dan olingan Telegram ID. Bir nechta admin bo'lsa vergul bilan: 111,222
ADMIN_IDS=
# TezTezAdmin.bas dagi LIC_SECRET qiymati (qo'shtirnoqsiz).
# Tez-Tez (TT) plagini va eski TZ- parollar shu kalit bilan hisoblanadi.
# Boshqa plaginlarning kalitlari bot bazasida saqlanadi (/plagin_qosh yaratadi).
LIC_SECRET=

# Tez-Tez uchun boshlang'ich narx (keyin /plagin_narx TT bilan o'zgartiriladi)
PRICE=100 000 so'm
CARD_NUMBER=8600 0000 0000 0000
CARD_OWNER=Ism Familiya

# Baza fayli. Unda plaginlarning maxfiy kalitlari ham bor - nusxasini saqlab turing!
DB_PATH=teztez.db
