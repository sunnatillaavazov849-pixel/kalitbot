# Sayt sozlamalari. Bu faylni .env nomi bilan nusxalang va to'ldiring.
# .env HECH QACHON GitHub'ga yuklanmaydi (u .gitignore da).

# Uzun tasodifiy satr (deploy/ornatish.sh o'zi yaratadi)
SECRET_KEY=
# Sinov uchun 1, serverda 0
DEBUG=0
# Sayt domeni (vergul bilan bir nechta)
ALLOWED_HOSTS=sunat.cc,www.sunat.cc
SITE_URL=https://sunat.cc

# Tez-Tez (TT) maxfiy kaliti - TezTezAdmin.bas dagi LIC_SECRET. Eski TZ- parollar ham shu bilan.
LIC_SECRET=

# To'lov uchun karta
CARD_NUMBER=8600 0000 0000 0000
CARD_OWNER=Ism Familiya

# Google orqali kirish (Google Cloud Console -> Credentials -> OAuth client ID). Bo'sh bo'lsa tugma ko'rinmaydi.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Yangi to'lov haqida email xabar (ixtiyoriy). Gmail uchun: smtp.gmail.com va "App password".
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
ADMIN_EMAILS=

# Ma'lumotlar papkasi (baza, rasmlar, cheklar). Bo'sh bo'lsa loyiha ichidagi data/
DATA_DIR=
